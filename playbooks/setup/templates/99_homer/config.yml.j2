---
title: "Raspberry Pi"
logo: "assets/tools/raspberry-pi.png"

columns: 3 # "auto" or number (must be a factor of 12: 1, 2, 3, 4, 6, 12)
connectivityCheck: true

defaults:
  layout: list # Either 'columns', or 'list'

theme: default # 'default' or one of the themes available in 'src/assets/themes'.

services:
  - items:
      - name: "Cockpit"
        logo: "assets/tools/cockpit.svg"
        url : "javascript:void(window.open(`//${location.hostname}:9090`, '_self'))"
      - name: "OpenSpeedTest"
        logo: "assets/tools/openspeedtest.svg"
        url : "javascript:void(window.open(`//${location.hostname}:3000`, '_self'))"
      - name: "Immich"
        logo: "assets/tools/immich.svg"
        url : "javascript:void(window.open(`//${location.hostname}:2283`, '_self'))"
      - name: "Pi-hole"
        logo: "assets/tools/pi-hole.svg"
        url : "javascript:void(window.open(`//${location.hostname}:8080/admin/`, '_self'))"
      - name: "MotionEye"
        logo: "assets/tools/motioneye.svg"
        url : "javascript:void(window.open(`//${location.hostname}:8765`, '_self'))"
      - name: "AriaNG"
        logo: "assets/tools/ariang.png"
        url : "javascript:void(window.open(`//${location.hostname}:4455`, '_self'))"
